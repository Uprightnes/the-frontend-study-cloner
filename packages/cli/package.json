{
  "name": "fsc",
  "version": "0.2.0",
  "description": "Capture any public website's frontend into a working local copy for study and learning.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fsc": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsc --build && node dist/cli.js",
    "postinstall": "node -e \"try{require('fs').existsSync('./dist/postinstall.js')&&require('child_process').execFileSync(process.execPath,['./dist/postinstall.js'],{stdio:'inherit'})}catch(e){}\""
  },
  "keywords": [
    "website-cloner",
    "web-capture",
    "static-site",
    "playwright",
    "nextjs",
    "frontend",
    "study",
    "developer-tools",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/frontend-study-cloner.git"
  },
  "homepage": "https://github.com/YOUR_USERNAME/frontend-study-cloner#readme",
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "fsc-core": "0.2.0",
    "commander": "^12.0.0",
    "prompts": "^2.4.2",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@types/prompts": "^2.4.9",
    "typescript": "^5.4.0"
  }
}
